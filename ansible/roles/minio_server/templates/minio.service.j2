# {{ ansible_managed }}
# role: minio_server - based on the upstream minio.service, with sandboxing
[Unit]
Description=MinIO object storage (external pool {{ minio_server_endpoint }})
Documentation=https://min.io/docs/minio/linux/index.html
Wants=network-online.target
After=network-online.target time-sync.target local-fs.target
AssertFileIsExecutable={{ minio_server_bin_dir }}/minio
# Drives are mounted `nofail` (storage_prep): never start on the root filesystem when a drive is missing
RequiresMountsFor={{ _minio_drive_paths | join(' ') }}

[Service]
Type=notify
WorkingDirectory=/usr/local
User={{ minio_server_user }}
Group={{ minio_server_group }}
EnvironmentFile={{ minio_server_config_file }}
ExecStartPre=/bin/bash -c 'if [ -z "${MINIO_VOLUMES}" ]; then echo "MINIO_VOLUMES not set in {{ minio_server_config_file }}"; exit 1; fi'
ExecStart={{ minio_server_bin_dir }}/minio server $MINIO_OPTS $MINIO_VOLUMES
Restart=always
RestartSec=5
LimitNOFILE=1048576
TasksMax=infinity
# Let MinIO finish in-flight writes on stop
TimeoutStopSec=infinity
SendSIGKILL=no
UMask=0027

# --- sandboxing ---
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ReadWritePaths={% for p in _minio_drive_paths %}{{ p }}/{{ minio_server_drive_subdir }} {% endfor %}

ReadOnlyPaths={{ minio_server_certs_dir }}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
