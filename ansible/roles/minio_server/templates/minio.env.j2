# {{ ansible_managed }}
# role: minio_server - read by /etc/systemd/system/minio.service
MINIO_VOLUMES="{{ minio_server_volumes | trim }}"
MINIO_OPTS="--address :{{ minio_server_port }} --console-address :{{ minio_server_console_port }} --certs-dir {{ minio_server_certs_dir }}"
MINIO_ROOT_USER="{{ minio_server_root_user }}"
MINIO_ROOT_PASSWORD="{{ minio_server_root_password }}"
# Public URL of the pool (round-robin DNS / VIP) - used for presigned URLs and the console
MINIO_SERVER_URL="{{ minio_server_endpoint }}"
MINIO_SITE_REGION="{{ minio_server_region }}"
MINIO_PROMETHEUS_AUTH_TYPE="{{ minio_server_prometheus_auth_type }}"
{% if minio_server_storage_class_standard | length > 0 %}
MINIO_STORAGE_CLASS_STANDARD="{{ minio_server_storage_class_standard }}"
{% endif %}
{% for key, value in minio_server_extra_env.items() %}
{{ key }}="{{ value }}"
{% endfor %}
