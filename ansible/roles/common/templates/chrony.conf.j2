# {{ ansible_managed }}
# role: common
{% for server in common_ntp_servers %}
server {{ server }} iburst
{% endfor %}
{% for pool in common_ntp_pools %}
pool {{ pool }} iburst maxsources 4
{% endfor %}

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
# Keep the kernel RTC in sync and step the clock at start-up if it is far off
rtcsync
makestep 1 3
leapsectz right/UTC
