# {{ ansible_managed }}
# AppRole "{{ vault_server_approle_name }}" - Ansible controller (secrets_backend: hashicorp_vault)
# Read the Ansible secrets of every environment
path "{{ vault_server_kv_path }}/data/ansible/*" {
  capabilities = ["read"]
}
path "{{ vault_server_kv_path }}/metadata/ansible/*" {
  capabilities = ["read", "list"]
}
# Push platform credentials generated by roles (MinIO service accounts, ...); read them back for idempotence
path "{{ vault_server_kv_path }}/data/platform/*" {
  capabilities = ["create", "read", "update"]
}
path "{{ vault_server_kv_path }}/metadata/platform/*" {
  capabilities = ["read", "list"]
}
