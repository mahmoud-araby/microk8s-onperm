{#- Python .env (python-dotenv / pydantic-settings with env_nested_delimiter="__").
    Standard variables (DB_HOST, REDIS_HOST, KAFKA_BOOTSTRAP_SERVERS, OTEL_* ...) are
    injected by charts/microservice; this file carries the application settings. -#}
{%- set levels = {'trace': 'DEBUG', 'debug': 'DEBUG', 'info': 'INFO', 'warn': 'WARNING', 'error': 'ERROR'} -%}
{%- set settings = {
  'app': {'name': service.name, 'version': service.version, 'environment': cfg.environment, 'tenantId': cfg.tenantId},
  'log': {'level': levels.get(cfg.logging.level, 'INFO'), 'format': cfg.logging.format},
  'http': {'port': cfg.http.port, 'timeoutSeconds': cfg.http.timeoutSeconds, 'retries': cfg.http.retries, 'corsAllowedOrigins': cfg.http.corsAllowedOrigins, 'gracefulTimeout': cfg.http.shutdownTimeoutSeconds},
  'auth': {'enabled': cfg.auth.enabled, 'issuer': cfg.auth.issuer, 'audience': cfg.auth.audience, 'tenantClaim': cfg.auth.tenantClaim},
  'otel': {'tracesSamplerRatio': cfg.otel.tracesSamplerRatio},
  'feature': cfg.features
} -%}
{%- if cfg.database.enabled | bool -%}
{%- set _ = settings.update({'db': {'name': cfg.database.namePrefix ~ cfg.database.name, 'readHost': cfg.database.readHost, 'sslMode': cfg.database.sslMode, 'poolMin': cfg.database.poolMin, 'poolMax': cfg.database.poolMax, 'commandTimeoutSeconds': cfg.database.commandTimeoutSeconds}}) -%}
{%- endif -%}
{%- if cfg.redis.enabled | bool -%}
{%- set _ = settings.update({'redis': {'db': cfg.redis.db, 'keyPrefix': cfg.redis.keyPrefix ~ service.name ~ ':', 'useSentinel': cfg.redis.useSentinel, 'sentinelHost': cfg.redis.sentinelHost, 'sentinelPort': cfg.redis.sentinelPort, 'sentinelMasterSet': cfg.redis.sentinelMasterSet}}) -%}
{%- endif -%}
{%- if cfg.rabbitmq.enabled | bool -%}
{%- set _ = settings.update({'rabbitmq': {'vhost': cfg.rabbitmq.vhost, 'prefetch': cfg.rabbitmq.prefetch}}) -%}
{%- endif -%}
{%- if cfg.kafka.enabled | bool -%}
{%- set _ = settings.update({'kafka': {'securityProtocol': cfg.kafka.securityProtocol, 'topicPrefix': cfg.kafka.topicPrefix, 'consumerGroup': cfg.kafka.consumerGroup or (cfg.kafka.topicPrefix ~ service.name ~ '-' ~ service.version), 'topics': cfg.kafka.topics}}) -%}
{%- endif -%}
# Generated by Ansible (k8s_configmaps) for {{ service.name }}-{{ service.version }} - do not edit
{% for key, value in (settings | combine(cfg.custom, recursive=True) | flatten_env(sep='__')).items() %}
{{ key }}={{ value | to_json }}
{% endfor %}
