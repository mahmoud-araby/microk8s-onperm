{#- Spring Boot application.yaml, mounted at /config/ (SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/config/).
    Credentials use ${ENV} placeholders resolved from the Vault-backed Secret. -#}
{%- set levels = {'trace': 'TRACE', 'debug': 'DEBUG', 'info': 'INFO', 'warn': 'WARN', 'error': 'ERROR'} -%}
{%- set level = levels.get(cfg.logging.level, 'INFO') -%}
{%- set db = cfg.database -%}
{%- set redis = cfg.redis -%}
{%- set db_name = db.namePrefix ~ db.name -%}
{%- set spring = {
  'application': {'name': service.name},
  'lifecycle': {'timeout-per-shutdown-phase': (cfg.http.shutdownTimeoutSeconds | string) ~ 's'},
  'threads': {'virtual': {'enabled': true}}
} -%}
{%- if db.enabled | bool -%}
{%- set _ = spring.update({'datasource': {
  'url': 'jdbc:postgresql://' ~ db.host ~ ':' ~ db.port ~ '/' ~ db_name ~ '?sslmode=' ~ db.sslMode ~ '&prepareThreshold=0',
  'username': '${DB_USER}',
  'password': '${DB_PASSWORD}',
  'hikari': {'minimum-idle': db.poolMin | int, 'maximum-pool-size': db.poolMax | int, 'connection-timeout': 5000, 'max-lifetime': 1800000}
}}) -%}
{%- endif -%}
{%- if redis.enabled | bool -%}
{%- if redis.useSentinel | bool -%}
{%- set _ = spring.update({'data': {'redis': {'sentinel': {'master': redis.sentinelMasterSet, 'nodes': redis.sentinelHost ~ ':' ~ redis.sentinelPort}, 'database': redis.db | int, 'password': '${REDIS_PASSWORD:}', 'timeout': '2s'}}}) -%}
{%- else -%}
{%- set _ = spring.update({'data': {'redis': {'host': redis.host, 'port': redis.port | int, 'database': redis.db | int, 'password': '${REDIS_PASSWORD:}', 'timeout': '2s'}}}) -%}
{%- endif -%}
{%- endif -%}
{%- if cfg.rabbitmq.enabled | bool -%}
{%- set _ = spring.update({'rabbitmq': {'host': cfg.rabbitmq.host, 'port': cfg.rabbitmq.port | int, 'virtual-host': cfg.rabbitmq.vhost, 'username': '${RABBITMQ_USER}', 'password': '${RABBITMQ_PASSWORD}', 'listener': {'simple': {'prefetch': cfg.rabbitmq.prefetch | int}}}}) -%}
{%- endif -%}
{%- if cfg.kafka.enabled | bool -%}
{%- set _ = spring.update({'kafka': {'bootstrap-servers': cfg.kafka.bootstrapServers, 'security': {'protocol': cfg.kafka.securityProtocol}, 'consumer': {'group-id': cfg.kafka.consumerGroup or (cfg.kafka.topicPrefix ~ service.name ~ '-' ~ service.version), 'auto-offset-reset': 'earliest'}}}) -%}
{%- endif -%}
{%- if cfg.auth.enabled | bool and cfg.auth.issuer -%}
{%- set _ = spring.update({'security': {'oauth2': {'resourceserver': {'jwt': {'issuer-uri': cfg.auth.issuer, 'audiences': [cfg.auth.audience]}}}}}) -%}
{%- endif -%}
{%- set doc = {
  'server': {'port': cfg.http.port | int, 'shutdown': 'graceful', 'tomcat': {'threads': {'max': 400}, 'max-connections': 10000}},
  'spring': spring,
  'management': {
    'server': {'port': cfg.http.port | int},
    'endpoints': {'web': {'base-path': '/', 'exposure': {'include': 'health,prometheus,info'}, 'path-mapping': {'prometheus': 'metrics'}}},
    'endpoint': {'health': {'probes': {'enabled': true}, 'show-details': 'never', 'group': {
      'live': {'include': 'livenessState'},
      'ready': {'include': 'readinessState' ~ (',db' if db.enabled | bool else '') ~ (',redis' if redis.enabled | bool else '') ~ (',rabbit' if cfg.rabbitmq.enabled | bool else '')},
      'startup': {'include': 'ping'}}}},
    'metrics': {'tags': {'application': service.name, 'version': service.version, 'tenant': cfg.tenantId or 'shared'}},
    'otlp': {'tracing': {'endpoint': cfg.otel.endpoint}},
    'tracing': {'sampling': {'probability': cfg.otel.tracesSamplerRatio | float}}
  },
  'logging': {'level': {'root': level}, 'structured': {'format': {'console': 'ecs'}}},
  'platform': {'environment': cfg.environment, 'tenant-id': cfg.tenantId, 'tenant-claim': cfg.auth.tenantClaim, 'http': {'timeout-seconds': cfg.http.timeoutSeconds | int, 'retries': cfg.http.retries | int}, 'features': cfg.features}
} -%}
{%- if redis.enabled | bool -%}
{%- set _ = doc.platform.update({'redis-key-prefix': redis.keyPrefix ~ service.name ~ ':'}) -%}
{%- endif -%}
{%- if cfg.kafka.enabled | bool -%}
{%- set _ = doc.platform.update({'kafka-topics': cfg.kafka.topics}) -%}
{%- endif -%}
# Generated by Ansible (k8s_configmaps) for {{ service.name }}-{{ service.version }} - do not edit
{{ doc | combine(cfg.custom, recursive=True) | to_nice_yaml(indent=2, sort_keys=false) }}
