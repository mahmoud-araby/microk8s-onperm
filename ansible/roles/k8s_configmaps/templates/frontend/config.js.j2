{#- nginx-served SPA runtime configuration: /usr/share/nginx/html/config.js
    (charts/frontend "runtimeConfig" contract: window.__CONFIG__, no rebuild per tenant). -#}
{%- set runtime = {
  'apiBaseUrl': cfg.frontend.apiBaseUrl,
  'authUrl': cfg.frontend.authUrl,
  'authClientId': cfg.frontend.authClientId | default(service.name),
  'tenantId': cfg.tenantId,
  'environment': cfg.environment,
  'version': service.version,
  'features': cfg.features,
  'telemetry': cfg.frontend.telemetry | default({'enabled': false})
} | combine(cfg.custom, recursive=True) -%}
/* Generated by Ansible (k8s_configmaps) for {{ service.name }}{{ ('-' ~ tenant.name) if tenant.tier | default('dedicated') == 'dedicated' else '' }} - do not edit */
window.__CONFIG__ = Object.freeze({{ runtime | to_nice_json(indent=2) }});
